<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Quotation -->
    <template id="report_purchasequotation_document" inherit_id="purchase.report_purchasequotation_document">
        <!-- Delivery Partner instead of direct address -->
        <t t-if="o.dest_address_id" position="attributes">
            <attribute name="t-if">o.delivery_partner_id</attribute>
        </t>
        <div name="purchase_shipping_address" position="attributes">
            <attribute name="t-field">o.delivery_partner_id</attribute>
        </div>

        <!-- Deliver Manager (human contact) -->
        <div name="purchase_shipping_address" position="after">
            <div t-if="o.delivery_manager_partner_id"
                name="purchase_shipping_manager"
            >
                <strong class="mt-5">Delivery contact:</strong>
                <div
                    t-field="o.delivery_manager_partner_id"
                    t-options='{
                        "widget": "contact",
                        "fields": ["name", "email", "phone", "mobile"],
                        "no_marker": True,
                        "phone_icons": True
                    }'
                />
            </div>
        </div>
    </template>

    <!-- Purchase Order -->
    <template id="report_purchaseorder_document" inherit_id="purchase.report_purchaseorder_document">
        <!-- Delivery Partner instead of direct address -->
        <t t-if="o.dest_address_id" position="attributes">
            <attribute name="t-if">o.delivery_partner_id</attribute>
        </t>
        <div t-if="o.dest_address_id" position="attributes">
            <attribute name="t-if">o.delivery_partner_id</attribute>
        </div>
        <div name="purchase_shipping_address" position="attributes">
            <attribute name="t-field">o.delivery_partner_id</attribute>
        </div>

        <!-- Deliver Manager (human contact) -->
        <div name="purchase_shipping_address" position="after">
            <div t-if="o.delivery_manager_partner_id"
                name="purchase_shipping_manager"
            >
                <strong class="mt-5">Delivery contact:</strong>
                <div
                    t-field="o.delivery_manager_partner_id"
                    t-options='{
                        "widget": "contact",
                        "fields": ["name", "email", "phone", "mobile"],
                        "no_marker": True,
                        "phone_icons": True
                    }'
                />
            </div>
        </div>
    </template>
</odoo>
