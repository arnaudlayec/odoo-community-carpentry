<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Planning Dashboard KPI Card: margins -->
    <t t-name="carpentry_planning.PlanningDashboard.margins" owl="1">
        <t t-foreach="data['margins']" t-as="margin" t-key="margin_index">
            <h6 t-esc="margin.label" class="mt-2 mb-0" />
            <div t-att-class="margin.class">
                <t t-esc="margin.amount" />
                <t t-if="margin.rate">
                    (<t t-esc="margin.rate" /> %)
                </t>
            </div>
        </t>

        <button class="mt-4 btn btn-primary"
            t-on-click="() => this.openDashboardRecord(
                'project.project', this.projectId, {budget_report: 1}
            )"
        >
            <span class="fa fa-external-link" /> Open
        </button>
    </t>

</templates>
