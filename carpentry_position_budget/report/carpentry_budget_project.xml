<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Project report (pre-select project before opening) -->
    <record id="action_open_budget_report_project_srv" model="ir.actions.server">
        <field name="name">Project result</field>
        <field name="model_id" ref="project_favorite_switch.model_project_choice_wizard" />
        <field name="state">code</field>
        <field name="code">
            action = model.action_choose_project_and_redirect('carpentry_position_budget.action_open_budget_report_project')
        </field>
    </record>
    <!-- Project report (real action) -->
    <record id="action_open_budget_report_project" model="ir.actions.act_window">
        <field name="name">Project result</field>
        <field name="res_model">carpentry.budget.project</field>
        <field name="view_mode">pivot,graph,tree</field>
    </record>

    <!-- Pivot -->
    <record id="carpentry_budget_report_project_pivot" model="ir.ui.view">
        <field name="name">carpentry.budget.project.pivot</field>
        <field name="model">carpentry.budget.project</field>
        <field name="priority">10</field>

        <field name="arch" type="xml">
            <pivot disable_linking="0">
                <field name="record_model_id" invisible="1" />
                <field name="currency_id" invisible="1" />
                
                <field name="budget_type" type="row" />
                <field name="analytic_account_id" type="row" />
                
                <field name="amount_available_valued" type="measure" />
                <field name="amount_reserved_valued" type="measure" />
                <field name="amount_expense_valued" type="measure" />
                <field name="amount_gain" type="measure" />
            </pivot>
        </field>
    </record>
    <!-- Graph -->
    <record id="carpentry_budget_report_project_graph" model="ir.ui.view">
        <field name="name">carpentry.budget.project.graph</field>
        <field name="model">carpentry.budget.project</field>
        <field name="priority">10</field>

        <field name="arch" type="xml">
            <graph type="bar" stacked="1" cumulated="0" disable_linking="0">
                <field name="currency_id" invisible="1" />
                <field name="record_model_id" invisible="1" />
                
                <field name="amount_gain" type="measure" />
                
                <field name="budget_type" />
                <field name="analytic_account_id" />
            </graph>
        </field>
    </record>
    <!-- Tree -->
    <record id="carpentry_budget_report_project_tree" model="ir.ui.view">
        <field name="name">carpentry.budget.project.tree</field>
        <field name="model">carpentry.budget.project</field>
        <field name="priority">10</field>
        <field name="inherit_id" ref="carpentry_position_budget.carpentry_budget_report_expense_tree" />
        <field name="mode">primary</field>
        
        <field name="arch" type="xml">
            <field name="amount_reserved" position="before">
                <!-- Show *available* only for `account.move.budget.line` -->
                <field name="record_res_model" invisible="1" />
                <field name="amount_available_valued" sum="1" optional="show"
                    attrs="{'invisible': [('record_res_model', '!=', 'account.move.budget.line')]}"
                />
            </field>

            <!-- Hide other field for `account.move.budget.line` -->
            <field name="amount_reserved_valued" position="attributes">
                <attribute name="attrs">{'invisible': [('record_res_model', '=', 'account.move.budget.line')]}</attribute>
            </field>
            <field name="amount_expense_valued" position="attributes">
                <attribute name="attrs">{'invisible': [('record_res_model', '=', 'account.move.budget.line')]}</attribute>
            </field>
            <field name="amount_gain" position="attributes">
                <attribute name="attrs">{'invisible': [('record_res_model', '=', 'account.move.budget.line')]}</attribute>
            </field>
            <field name="amount_gain" position="after">
                <field
                    name="amount_expense_forecast"
                    sum="1"
                    optional="show"
                    attrs="{'invisible': [('record_res_model', '=', 'account.move.budget.line')]}"
                />
            </field>
        </field>
    </record>
    <!-- Search -->
    <record id="carpentry_budget_report_project_search" model="ir.ui.view">
        <field name="name">carpentry.budget.project.search</field>
        <field name="model">carpentry.budget.project</field>
        <field name="priority">10</field>
        <field name="inherit_id" ref="carpentry_position_budget.carpentry_budget_report_expense_search" />
        <field name="mode">primary</field>
        
        <field name="arch" type="xml">
            <!-- Remove 'w/o' reservations filters -->
            <filter name="filter_reservation" position="replace" />
            <filter name="filter_reservation_empty" position="replace" />
            <separator name="with_reservation" position="replace" />
        </field>
    </record>
</odoo>
