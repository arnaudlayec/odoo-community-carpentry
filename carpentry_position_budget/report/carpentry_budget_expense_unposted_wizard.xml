<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Unposted (real action - after date wizard) -->
    <record id="action_open_budget_report_expense_unposted_wizard" model="ir.actions.act_window">
        <field name="name">Unposted expenses</field>
        <field name="res_model">carpentry.budget.expense.unposted.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <record id="action_open_budget_report_expense_unposted" model="ir.actions.act_window">
        <field name="name">Unposted expenses</field>
        <field name="res_model">carpentry.budget.expense.detail</field>
        <field name="view_mode">pivot,tree</field>
        <field name="context">{
            'display_model_shortname': 1,
        }</field>
    </record>

    <!-- Wizard -->
    <record id="view_budget_expense_unposted_wizard" model="ir.ui.view">
        <field name="name">Unposted expenses</field>
        <field name="model">carpentry.budget.expense.unposted.wizard</field>

        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="date" />
                        <field name="date_times_posted" />
                    </group>
                </sheet>
                
                <footer>
                    <button type="object" name="action_open" string="Open" class="btn btn-primary" />
                    <button special="cancel" string="Discard" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
