<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Pivot -->
    <record id="carpentry_budget_report_project_forecast_pivot" model="ir.ui.view">
        <field name="name">carpentry.budget.project.forecast.pivot</field>
        <field name="model">carpentry.budget.project</field>
        <field name="priority">1000</field>

        <field name="arch" type="xml">
            <pivot disable_linking="0">
                <field name="record_model_id" invisible="1" />
                <field name="currency_id" invisible="1" />

                <field name="project_id" type="row" />

                <field name="budget_type" type="col" />

                <field name="amount_available" type="measure" />
                <field name="amount_expense" type="measure" />
                <field name="amount_gain" type="measure" />
                <field name="amount_expense_forecast" type="measure" />
            </pivot>
        </field>
    </record>
    <!-- Graph -->
    <record id="carpentry_budget_report_project_forecast_graph" model="ir.ui.view">
        <field name="name">carpentry.budget.project.forecast.graph</field>
        <field name="model">carpentry.budget.project</field>
        <field name="priority">1000</field>

        <field name="arch" type="xml">
            <graph type="bar" stacked="1" cumulated="0" disable_linking="0">
                <field name="record_model_id" invisible="1" />
                <field name="currency_id" invisible="1" />
                
                <field name="amount_expense_forecast" type="measure" />
                
                <field name="budget_type" />
                <field name="project_id" />
            </graph>
        </field>
    </record>
    
    <!-- Project forecast report (real action) -->
    <record id="action_open_budget_report_project_forecast" model="ir.actions.act_window">
        <field name="name">Expense forecast</field>
        <field name="res_model">carpentry.budget.project</field>
        <field name="view_mode">graph,pivot,tree</field>
        <field name="context">{
            "search_default_my_favorite_projects": 1,
            "search_default_filter_production": 1,
        }</field>
    </record>
    <!-- ir.actions.act_window.view -->
    <record id="action_open_budget_report_project_forecast_pivot" model="ir.actions.act_window.view">
        <field name="sequence" eval="10"/>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="carpentry_position_budget.carpentry_budget_report_project_forecast_pivot"/>
        <field name="act_window_id" ref="carpentry_position_budget.action_open_budget_report_project_forecast"/>
    </record>
    <record id="action_open_budget_report_project_forecast_graph" model="ir.actions.act_window.view">
        <field name="sequence" eval="20"/>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="carpentry_position_budget.carpentry_budget_report_project_forecast_graph"/>
        <field name="act_window_id" ref="carpentry_position_budget.action_open_budget_report_project_forecast"/>
    </record>
    <record id="action_open_budget_report_project_forecast_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="30"/>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="carpentry_position_budget.carpentry_budget_report_project_tree"/>
        <field name="act_window_id" ref="carpentry_position_budget.action_open_budget_report_project_forecast"/>
    </record>
</odoo>
